# TypeSafe API key for Jev. Server-side only (never prefix with NEXT_PUBLIC_).
# Without it, the app runs entirely on its built-in rules.
# Local: put it in .env.local. Vercel: add it under Project → Settings → Environment Variables.
TYPESAFE_API_KEY=

# Optional: set to "rules" to skip Jev even when a key is present.
# NEXT_PUBLIC_ENGINE=rules

# Optional: new Jev questions each server instance may ask per hour before
# falling back to rules (caps spend if anyone abuses the endpoint). Default 300.
# JEV_HOURLY_BUDGET=300
